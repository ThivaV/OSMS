# The deployed OSMS on Google Cloud (DEPLOY.md). Names and places only, never a secret:
# keys live in Secret Manager. GitHub Actions reads the same values from the repo's
# Actions variables, and a variable already set in the environment wins over this file.
GCP_PROJECT_ID=meta-osms
GCP_REGION=europe-north1
GCP_ZONE=europe-north1-a
GCP_VM=osms
GCP_MACHINE_TYPE=e2-highmem-4
# The DuckDNS name (yourname.duckdns.org): app., auth. and api. under it reach the server.
OSMS_DOMAIN=onestory-osms.duckdns.org
