# Variable names only. Real values go in .env (gitignored) or the deploy
# platform's secret store. Never commit a value.

# Databases
DATABASE_URL=
# Milvus Lite's data (default data/milvus.db); the worker serves it on 127.0.0.1 only.
OSMS_MILVUS_PATH=
# Morning briefing audio (default data/briefings); the worker writes, the API serves.
OSMS_BRIEFINGS_DIR=
# Story illustrations (default data/visuals); the worker writes, the API serves.
OSMS_VISUALS_DIR=

# Meta models (model ids are pinned in backend/app/config.py, not here)
META_API_KEY=
BASETEN_API_KEY=
# Baseten's deployment URL for Muse Spark Open (the judge). Empty until set;
# the Day 5 client refuses to judge without it.
BASETEN_BASE_URL=
# Muse Glimmer: the local Ollama server (default http://127.0.0.1:11434/v1), or a
# hosted provider's OpenAI-compatible URL when deployed
GLIMMER_BASE_URL=
GLIMMER_API_KEY=

# Sign-in: the Better Auth service in auth/ (users and sessions in data/auth.db)
# `make env` fills BETTER_AUTH_SECRET with a random value. Keep it secret.
BETTER_AUTH_SECRET=
# Where the auth service is reached (default http://localhost:3000)
BETTER_AUTH_URL=
# Google sign-in: an OAuth client from Google Cloud (redirect URI
# <BETTER_AUTH_URL>/api/auth/callback/google). Without these, Google sign-in is off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The app's web origins, comma-separated (default http://localhost:8080)
OSMS_APP_ORIGINS=
# The audience of the API's tokens (default osms-api)
OSMS_API_AUDIENCE=
# Local development only: sign in with a link printed in the auth log. Never in production.
OSMS_DEV_SIGN_IN=

# Briefing audio: open-source TTS pick (needs Danish + Tamil voices)
TTS_PROVIDER=
TTS_VOICE_EN=
TTS_VOICE_DA=
TTS_VOICE_TA=

# Optional: candidate-site search for "add by name or topic" (ask before adding one)
SEARCH_API_KEY=

# arXiv politeness contact (used in User-Agent so arXiv can reach us)
ARXIV_CONTACT_EMAIL=

# Fetching guardrails
FETCH_MAX_BYTES=
ADD_SOURCE_RATE_LIMIT=
