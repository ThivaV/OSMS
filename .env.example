# Variable names only. Real values go in .env (gitignored) or the deploy
# platform's secret store. Never commit a value.

# Databases
DATABASE_URL=
MILVUS_URI=

# Meta models (model ids are pinned in backend/app/config.py, not here)
META_API_KEY=
BASETEN_API_KEY=
# Muse Glimmer: the local Ollama server, or a hosted provider when deployed
GLIMMER_BASE_URL=
GLIMMER_API_KEY=

# Sign-in (Firebase web config is public; restrict its key to our domains)
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Briefing audio: open-source TTS pick (needs Danish + Tamil voices)
TTS_PROVIDER=
TTS_VOICE_EN=
TTS_VOICE_DA=
TTS_VOICE_TA=

# Optional: candidate-site search for "add by name or topic" (ask before adding one)
SEARCH_API_KEY=

# arXiv politeness contact (used in User-Agent so arXiv can reach us)
ARXIV_CONTACT_EMAIL=

# Fetching guardrails
FETCH_MAX_BYTES=
ADD_SOURCE_RATE_LIMIT=
